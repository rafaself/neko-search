{
  "name": "nekosearch",
  "version": "0.0.2",
  "description": "A local, read-only MCP server for searching and fetching documentation snapshots.",
  "type": "module",
  "workspaces": [
    "apps/docs-indexer",
    "packages/documentation-engine"
  ],
  "bin": {
    "nekosearch": "./dist/apps/nekosearch/cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaself/neko-search.git"
  },
  "homepage": "https://github.com/rafaself/neko-search#readme",
  "bugs": {
    "url": "https://github.com/rafaself/neko-search/issues"
  },
  "keywords": [
    "documentation",
    "local",
    "mcp",
    "model-context-protocol",
    "stdio",
    "offline",
    "search"
  ],
  "files": [
    "dist/apps/nekosearch/**",
    "dist/apps/nekosearch/build-runtime/config/documentation-build-config.js",
    "dist/apps/nekosearch/build-runtime/services/build-documentation-snapshot.js",
    "dist/apps/nekosearch/build-runtime/services/build-local-documentation.js",
    "dist/modules/documentation/mcp/contracts/documentation-tools.contract.js",
    "dist/modules/documentation/mcp/documentation-tool-handlers.js",
    "dist/modules/documentation/mcp/presenters/documentation.presenter.js",
    "dist/shared/config/package-metadata.js",
    "data/mcp-protocol/**",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses/nestjs-docs-v11-LICENSE",
    "licenses/nestjs-docs-v12-LICENSE"
  ],
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs-docs/documentation-engine": "0.1.0",
    "@nestjs/common": "^12.5.0",
    "json5": "^2.2.3",
    "nekosearch": "^0.0.0-stage",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@nestjs-docs/documentation-engine",
    "reflect-metadata"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:engine": "npm run build --workspace @nestjs-docs/documentation-engine",
    "build:indexer": "npm run build --workspace @nestjs-docs/docs-indexer",
    "build:server": "nest build",
    "build": "npm run build:engine && npm run build:indexer && npm run build:server && node scripts/build/copy-nekosearch-build-runtime.mjs",
    "prepack": "npm run build && node scripts/ci/verify-package.mjs && node scripts/ci/verify-packed-package.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/apps/mcp-server/bootstrap/http.js",
    "start:stdio": "node dist/apps/mcp-server/bootstrap/stdio.js",
    "start:nekosearch": "node dist/apps/nekosearch/cli.js",
    "docs:build": "npm run build && node apps/docs-indexer/dist/cli.js build",
    "docs:ingest": "npm run build && node apps/docs-indexer/dist/cli.js ingest",
    "docs:build:mcp": "npm run build && node scripts/release/build-mcp-protocol-snapshot.mjs",
    "search:index": "npm run build && node apps/docs-indexer/dist/cli.js index",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "search:evaluate": "npm run build && node scripts/evaluation/evaluate-search.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/core": "^12.5.0",
    "@nestjs/mcp": "^0.0.4",
    "@nestjs/platform-express": "^12.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
