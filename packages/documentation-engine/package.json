{
  "name": "@nestjs-docs/documentation-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable documentation discovery, parsing, indexing, and retrieval components.",
  "type": "module",
  "exports": {
    "./domain/*": "./dist/domain/*",
    "./application/*": "./dist/application/*",
    "./infrastructure/*": "./dist/infrastructure/*",
    "./retrieval/*": "./dist/retrieval/*",
    "./build/*": "./dist/build/*"
  },
  "files": [
    "dist/application/services/documentation-search.service.js",
    "dist/domain/documentation-index-manifest.schemas.js",
    "dist/domain/documentation-embedding.schemas.js",
    "dist/domain/documentation.schemas.js",
    "dist/application/services/documentation-ingestion.service.js",
    "dist/infrastructure/sqlite/documentation-index-manifest.js",
    "dist/infrastructure/sqlite/index-schema.js",
    "dist/infrastructure/sqlite/runtime-index.js",
    "dist/infrastructure/sqlite/documentation-embeddings.js",
    "dist/infrastructure/sqlite/sqlite-documentation-store.js",
    "dist/infrastructure/sqlite/indexing/index-corpus.js",
    "dist/infrastructure/sqlite/indexing/index-integrity.js",
    "dist/infrastructure/sqlite/indexing/index-writer.js",
    "dist/infrastructure/filesystem/documentation-discovery.js",
    "dist/infrastructure/markdown/document-normalizer.js",
    "dist/infrastructure/markdown/documentation-link-resolver.js",
    "dist/infrastructure/markdown/markdown-parser.js",
    "dist/retrieval/document-page.js",
    "dist/retrieval/documentation-input.error.js",
    "dist/retrieval/search-input.js",
    "dist/retrieval/search.constants.js",
    "dist/retrieval/fusion/reciprocal-rank-fusion.js",
    "dist/retrieval/retrievers/semantic-retriever.js",
    "dist/build/build-local-documentation.js",
    "dist/build/build-documentation-snapshot.js",
    "dist/build/documentation-build-config.js"
  ],
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
